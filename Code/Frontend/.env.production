# Production build. The API is served by the same process and origin as this
# bundle, so the base URL is relative — one build works on any host, and the
# frontend never needs rebuilding because a server's address changed.
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=NanoVox

# Corpus run in the rail. Set to false for a build a demo audience will drive;
# the route stays reachable by address either way.
VITE_SHOW_CORPUS_RUN=false
