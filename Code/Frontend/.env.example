# NanoVox frontend configuration.
#
# Copy to .env. Vite only exposes variables prefixed with VITE_ to the browser,
# so nothing secret belongs in this file — it is compiled into the bundle.

# Base URL of the backend API, including the version prefix and no trailing slash.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Shown in the browser tab and the application header.
VITE_APP_NAME=NanoVox
