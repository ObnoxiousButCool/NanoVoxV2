# NanoVox frontend configuration.
#
# Copy to .env. Vite only exposes variables prefixed with VITE_ to the browser,
# so nothing secret belongs in this file — it is compiled into the bundle.

# Base URL of the backend API, including the version prefix and no trailing
# slash. Absolute here because `npm run dev` serves this on port 5173 while
# the backend is on 8000. Production builds use .env.production, where it is
# the relative /api/v1 — deployed, one process serves both.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Shown in the browser tab and the application header.
VITE_APP_NAME=NanoVox

# Whether the Corpus run screen appears in the navigation rail.
#
# The route and the page exist either way — turning this off only removes the
# rail entry, so /corpus stays reachable by typing the address. That is the
# point: an operator can still start a run while a demo audience has nothing to
# click. Unset means on. Accepts true/false, 1/0, yes/no, on/off; anything else
# fails at startup rather than being read as false.
VITE_SHOW_CORPUS_RUN=true
