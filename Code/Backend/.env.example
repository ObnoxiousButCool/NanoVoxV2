# NanoVox backend configuration.
#
# Copy to .env and adjust. Every value below has a working default for a local
# run, so an unedited copy of this file starts the application successfully.
# The application validates this configuration at startup and fails fast with an
# explicit message rather than erroring on first use.
#
# Settings arrive with the phase that uses them (P0 = application, database and
# logging). LLM provider settings arrived in P2, corpus settings in P7.

# --- Application -----------------------------------------------------------
# One of: local | dev | prod
APP_ENV=local
APP_NAME=NanoVox
APP_VERSION=0.1.0
APP_HOST=127.0.0.1
APP_PORT=8000
API_PREFIX=/api/v1
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Database --------------------------------------------------------------
# SQLite via the async aiosqlite driver. The parent directory is created at
# startup if it does not exist.
#
# Left unset on purpose. The default is <repo>/Data/nanovox.db, resolved from the
# code's own location, so a checkout works wherever it is cloned. Set it only to
# put the database somewhere else — a deployment, or a second database for
# testing. Note the forward slashes: SQLAlchemy URLs are POSIX-style on Windows.
# DATABASE_URL=sqlite+aiosqlite:///D:/NanoVox/data/nanovox.db
# Echo every SQL statement to the logger. Leave false outside of debugging.
DB_ECHO=false

# --- Analysis configuration ------------------------------------------------
# The controlled vocabularies the analysis is constrained to, and the scoring
# rubric. Both are validated at startup; a malformed file stops the application
# with a message naming the offending key.
#
# All three default to Code/Backend/config/, resolved from the code's own
# location. Set them only when the files live outside the checkout, as they do
# in a packaged deployment.
# TAXONOMY_PATH=D:/NanoVox/config/taxonomy.yaml
# RUBRIC_PATH=D:/NanoVox/config/rubric.yaml
# Histogram bins and the rules that decide what reaches the attention queue.
# DASHBOARD_PATH=D:/NanoVox/config/dashboard.yaml

# The built frontend, served by this process so a deployment is one process on
# one port. Defaults to <repo>/Code/Frontend/dist. Absent during development,
# where Vite serves the frontend on its own port and the API serves only the API.
# FRONTEND_DIST_PATH=D:/NanoVox/dist

# --- Corpus run (DEC-06) ---------------------------------------------------
# The authored call corpus, re-analysed end to end from the Corpus screen.
# CORPUS_GLOB selects which files in that directory are calls, so an unrelated
# README sitting beside them is not sent to a model.
#
# Defaults to <repo>/Samples.
# CORPUS_PATH=D:/NanoVox/samples
CORPUS_GLOB=call_*.md

# How a member identifier looks when spoken in a call. Read from the
# transcript by pattern rather than by a model: an identifier is a fixed
# shape, so a pattern is exact and free where a model would be approximate,
# billed, and able to invent a plausible number belonging to someone else.
# A different plan administrator issues a different format, which is why this
# is configuration. Leave blank to store no member identifier at all.
# CHM is CaliforniaChoice, CB is ChoiceBuilder. Group numbers (GRP-...) are
# excluded on purpose: an employer's group is not a member identifier.
MEMBER_ID_PATTERN=\b(?:CHM|CB)[-\s]?\d{6,}\b

# The words that make a quote evidence of a broker relationship. An
# attribution whose quote contains none of them is describing somebody else —
# a surgeon, a pharmacy, the agent on the call — and is refused rather than
# recorded against a real person. Comma separated; blank disables the check.
BROKER_EVIDENCE_TERMS=broker,broker of record,BOR


# How many calls are analysed at once. Two is right for a local model: Ollama
# serves one model, so more concurrent requests make each call slower without
# finishing the run any sooner. Raise it for a cloud provider, which is limited
# by rate limits rather than by one GPU.
CORPUS_RUN_CONCURRENCY=2

# --- Model providers -------------------------------------------------------
# Which provider to use when the caller does not choose one.
# One of: ollama | openai | anthropic | azure_foundry
#
# azure_foundry is registered but NOT implemented in this build: selecting it
# fails immediately with an explicit message. It never falls back to another
# provider, because silently answering an Azure request with OpenAI would defeat
# the reason for asking.
LLM_PROVIDER=ollama

# Applies to every provider. The timeout is generous because a 5-layer analysis
# on a local model is slow; retries cover transient network failure only.
LLM_TIMEOUT_SECONDS=120
# How long the provider picker waits for a provider to say it is alive. Short on
# purpose: this is a dropdown, not a run. An unreachable host is then shown as
# unavailable rather than blocking the screen until the socket gives up.
LLM_PROBE_TIMEOUT_SECONDS=5
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=4096

# Local, on-premise inference. This is the default path and the one the product's
# privacy claim depends on: nothing leaves this environment.
# Install the model first:  ollama pull qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Cloud providers. Leave the keys blank unless you intend to send transcripts off
# this machine. A blank key is fine until that provider is actually selected, at
# which point startup fails with a message naming the missing variable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: an OpenAI-compatible gateway. Blank uses the official endpoint.
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Logging ---------------------------------------------------------------
# Master switch. When false, no log files are created and no handlers attached.
LOG_ENABLED=true
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Defaults to <repo>/Logs.
# LOG_DIR=D:/NanoVox/logs
# One of: json | text
LOG_FORMAT=json
# Log files rotate at midnight; this many rotated files are retained.
LOG_RETENTION_DAYS=14
# Mirror logs to the console as well as to disk.
LOG_TO_CONSOLE=true

# Write full prompts and model responses into nanovox-llm-audit.log.
# Off by default: transcripts are member conversations, and an audit log is not
# the place to accumulate them. Turn on only for prompt debugging.
LOG_LLM_PROMPTS=false
