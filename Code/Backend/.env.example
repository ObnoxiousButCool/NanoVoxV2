# NanoVox backend configuration.
#
# Copy to .env and adjust. Every value below has a working default for a local
# run, so an unedited copy of this file starts the application successfully.
# The application validates this configuration at startup and fails fast with an
# explicit message rather than erroring on first use.
#
# Settings arrive with the phase that uses them (P0 = application, database and
# logging). LLM provider settings land in P2, corpus settings in P7.

# --- Application -----------------------------------------------------------
# One of: local | dev | prod
APP_ENV=local
APP_NAME=NanoVox
APP_VERSION=0.1.0
APP_HOST=127.0.0.1
APP_PORT=8000
API_PREFIX=/api/v1
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Database --------------------------------------------------------------
# SQLite via the async aiosqlite driver. The parent directory is created at
# startup if it does not exist. Default: <repo>/Data/nanovox.db
DATABASE_URL=sqlite+aiosqlite:///C:/Technossus/Code/NanoVox-V2/Data/nanovox.db
# Echo every SQL statement to the logger. Leave false outside of debugging.
DB_ECHO=false

# --- Analysis configuration ------------------------------------------------
# The controlled vocabularies the analysis is constrained to, and the scoring
# rubric. Both are validated at startup; a malformed file stops the application
# with a message naming the offending key.
TAXONOMY_PATH=C:/Technossus/Code/NanoVox-V2/Code/Backend/config/taxonomy.yaml
RUBRIC_PATH=C:/Technossus/Code/NanoVox-V2/Code/Backend/config/rubric.yaml

# --- Model providers -------------------------------------------------------
# Which provider to use when the caller does not choose one.
# One of: ollama | openai | anthropic | azure_foundry
#
# azure_foundry is registered but NOT implemented in this build: selecting it
# fails immediately with an explicit message. It never falls back to another
# provider, because silently answering an Azure request with OpenAI would defeat
# the reason for asking.
LLM_PROVIDER=ollama

# Applies to every provider. The timeout is generous because a 5-layer analysis
# on a local model is slow; retries cover transient network failure only.
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=4096

# Local, on-premise inference. This is the default path and the one the product's
# privacy claim depends on: nothing leaves this environment.
# Install the model first:  ollama pull qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Cloud providers. Leave the keys blank unless you intend to send transcripts off
# this machine. A blank key is fine until that provider is actually selected, at
# which point startup fails with a message naming the missing variable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: an OpenAI-compatible gateway. Blank uses the official endpoint.
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Logging ---------------------------------------------------------------
# Master switch. When false, no log files are created and no handlers attached.
LOG_ENABLED=true
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
LOG_DIR=C:/Technossus/Code/NanoVox-V2/Logs
# One of: json | text
LOG_FORMAT=json
# Log files rotate at midnight; this many rotated files are retained.
LOG_RETENTION_DAYS=14
# Mirror logs to the console as well as to disk.
LOG_TO_CONSOLE=true

# Write full prompts and model responses into nanovox-llm-audit.log.
# Off by default: transcripts are member conversations, and an audit log is not
# the place to accumulate them. Turn on only for prompt debugging.
LOG_LLM_PROMPTS=false
