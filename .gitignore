# --- Secrets and local configuration ---------------------------------------
# .env.example is committed; .env never is.
.env
.env.local
.env.*.local

# --- Runtime output ---------------------------------------------------------
Logs/
*.db-wal
*.db-shm

# --- Python -----------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.import_linter_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Node -------------------------------------------------------------------
node_modules/
dist/
coverage/
*.tsbuildinfo

# --- Editors and OS ---------------------------------------------------------
.idea/
.vscode/
Thumbs.db
Desktop.ini

# Imported corpora. A byproduct of the Corpus import screen: the same calls
# the tracked Samples/ files hold, kept per-upload so an import cannot
# overwrite the corpus a stored analysis was made from.
Samples/imported/

# Database backups taken before a corpus re-run. One multi-megabyte binary
# per run, and the committed Data/nanovox.db already carries the state that
# matters, so these stay local.
Data/backup/
